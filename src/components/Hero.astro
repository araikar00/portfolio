---
import { site } from '../data/site';
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="hero-atmosphere" aria-hidden="true">
    <div class="hero-grid"></div>
    <div class="hero-glow"></div>
    <div class="hero-grain"></div>
  </div>
  <div class="wrap hero-content">
    <p class="hero-kicker hero-animate" style="--d: 0ms">{site.title}</p>
    <h1 id="hero-name" class="hero-name hero-animate" style="--d: 80ms">{site.name}</h1>
    <p class="hero-headline hero-animate" style="--d: 160ms">{site.headline}</p>
    <p class="hero-summary hero-animate" style="--d: 240ms">{site.summary}</p>
    <div class="hero-actions hero-animate" style="--d: 320ms">
      <a class="btn btn-primary" href={site.resumePath} target="_blank" rel="noopener noreferrer">
        View resume
      </a>
      <a class="btn btn-ghost" href="#contact">Contact</a>
      <a class="btn btn-ghost" href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: grid;
    align-items: center;
    overflow: clip;
    isolation: isolate;
  }

  .hero-atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 80% 55% at 15% 20%, rgba(139, 164, 184, 0.16), transparent 55%),
      radial-gradient(ellipse 60% 45% at 85% 70%, rgba(92, 115, 136, 0.12), transparent 50%),
      linear-gradient(180deg, #0c0f12 0%, #10151a 55%, #0c0f12 100%);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(139, 164, 184, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(139, 164, 184, 0.07) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 20%, transparent 75%);
  }

  .hero-glow {
    position: absolute;
    width: min(42rem, 80vw);
    height: min(42rem, 80vw);
    right: -8%;
    top: 10%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(168, 192, 210, 0.12), transparent 65%);
    filter: blur(8px);
  }

  .hero-grain {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.45'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .hero-content {
    padding-block: clamp(3.5rem, 12vh, 7rem);
  }

  .hero-kicker {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--steel);
    margin-bottom: 1.25rem;
  }

  .hero-name {
    font-size: clamp(3rem, 10vw, 6.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin-bottom: 1.25rem;
    max-width: 12ch;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    max-width: 28ch;
    margin-bottom: 1rem;
  }

  .hero-summary {
    max-width: 36rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-animate {
    opacity: 0;
    transform: translateY(1.1rem);
    animation: rise-in 800ms var(--ease) forwards;
    animation-delay: var(--d, 0ms);
  }

  @keyframes rise-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
