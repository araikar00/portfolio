---
import { site } from '../data/site';
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="wrap hero-content">
    <p class="hero-kicker hero-animate" style="--d: 0ms">{site.title}</p>
    <h1 id="hero-name" class="hero-name hero-animate" style="--d: 70ms">{site.name}</h1>
    <p class="hero-headline hero-animate" style="--d: 140ms">{site.headline}</p>
    <p class="hero-summary hero-animate" style="--d: 210ms">{site.summary}</p>
    <div class="hero-actions hero-animate" style="--d: 280ms">
      <a class="btn btn-primary" href={site.resumePath} target="_blank" rel="noopener noreferrer">
        View resume
      </a>
      <a class="btn btn-ghost" href="#contact">Contact</a>
      <a class="btn btn-ghost" href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 5.5rem);
    display: grid;
    align-items: center;
  }

  .hero-content {
    padding-block: clamp(4rem, 14vh, 8rem);
    max-width: 44rem;
  }

  .hero-kicker {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .hero-name {
    font-size: clamp(3.25rem, 9vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.98;
    margin-bottom: 1.15rem;
  }

  .hero-headline {
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.3;
    color: var(--text);
    max-width: 26ch;
    margin-bottom: 0.85rem;
  }

  .hero-summary {
    max-width: 34rem;
    color: var(--text-secondary);
    font-size: 1.125rem;
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .hero-animate {
    opacity: 0;
    transform: translateY(0.9rem);
    animation: rise-in 700ms var(--ease) forwards;
    animation-delay: var(--d, 0ms);
  }

  @keyframes rise-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
