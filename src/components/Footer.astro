---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <p>© {year} {site.name}</p>
    <p class="footer-note">Built with Astro · Hosted on Vercel</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 2rem 2.5rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.5rem;
    justify-content: space-between;
    color: var(--text-tertiary);
    font-size: 0.875rem;
  }

  .footer-note {
    font-size: 0.8125rem;
  }
</style>
