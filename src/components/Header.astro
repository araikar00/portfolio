---
import { site } from '../data/site';

const links = [
  { href: '#work', label: 'Work' },
  { href: '#experience', label: 'Experience' },
  { href: '#education', label: 'Education' },
  { href: '#skills', label: 'Skills' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="wrap header-shell">
    <div class="nav-dock">
      <div class="liquid-gl liquid-gl--nav" id="nav-lens" aria-hidden="true"></div>
      <div class="header-inner" id="nav-content">
        <a class="brand" href="#top">{site.name}</a>
        <nav class="nav" aria-label="Primary">
          {
            links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))
          }
        </nav>
        <details class="mobile-nav">
          <summary class="mobile-nav-toggle" aria-label="Open menu">Menu</summary>
          <div class="mobile-nav-panel" role="navigation" aria-label="Mobile">
            {
              links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))
            }
          </div>
        </details>
        <a
          class="btn btn-primary header-cta"
          href={site.resumePath}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open resume PDF"
        >
          Resume
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const mobileNav = document.querySelector('.mobile-nav');
  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (mobileNav instanceof HTMLDetailsElement) mobileNav.open = false;
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: 0.85rem;
    padding-bottom: 0.5rem;
  }

  .header-shell {
    display: flex;
    justify-content: center;
  }

  /* Lens below; labels/links above the liquidGL canvas */
  .nav-dock {
    position: relative;
    z-index: 60;
    width: fit-content;
    max-width: 100%;
  }

  .liquid-gl--nav {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius-pill);
    pointer-events: none;
  }

  .header-inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3.4rem;
    padding: 0.4rem 0.45rem 0.4rem 1.2rem;
    border-radius: var(--radius-pill);
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.02em;
    color: var(--text);
    text-decoration: none;
    margin-right: auto;
    white-space: nowrap;
  }

  .nav {
    display: none;
    align-items: center;
    gap: 0.1rem;
  }

  .nav a {
    color: var(--text);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    padding: 0.45rem 0.7rem;
    border-radius: var(--radius-pill);
  }

  .nav a:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.45);
  }

  .mobile-nav {
    position: relative;
  }

  .mobile-nav-toggle {
    list-style: none;
    cursor: pointer;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.4);
    border: 1px solid rgba(16, 16, 16, 0.06);
  }

  .mobile-nav-toggle::-webkit-details-marker {
    display: none;
  }

  .mobile-nav-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.55rem);
    z-index: 60;
    display: grid;
    gap: 0.15rem;
    min-width: 10.5rem;
    padding: 0.45rem;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: var(--radius);
    box-shadow: 0 12px 40px rgba(16, 16, 16, 0.12);
  }

  .mobile-nav-panel a {
    color: var(--text);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.65rem 0.75rem;
    border-radius: 0.75rem;
  }

  .header-cta {
    min-height: 2.4rem;
    padding-inline: 1.05rem;
    font-size: 0.8125rem;
    flex-shrink: 0;
  }

  @media (min-width: 860px) {
    .nav {
      display: flex;
    }

    .mobile-nav {
      display: none;
    }
  }
</style>
