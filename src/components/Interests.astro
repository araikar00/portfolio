---
import { interests } from '../data/interests';
---

<section class="section interests" id="interests" aria-labelledby="interests-title">
  <div class="wrap">
    <div class="reveal">
      <p class="section-label">Interests</p>
      <h2 class="section-title" id="interests-title">What keeps me curious</h2>
      <p class="section-lead">Signals beyond the resume — the problems and environments I care about.</p>
    </div>

    <div class="interest-glass">
      <div class="liquid-gl liquid-gl--card">
        <ul class="liquid-gl__content interest-list">
          {
            interests.map((item) => (
              <li>{item}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .interest-glass {
    max-width: 40rem;
  }

  .interest-list {
    display: grid;
    gap: 0;
    padding: 0.4rem;
    margin: 0;
    list-style: none;
  }

  .interest-list li {
    padding: 1rem 1.25rem;
    color: var(--text-secondary);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.45;
  }

  .interest-list li + li {
    border-top: 1px solid var(--line);
  }
</style>
