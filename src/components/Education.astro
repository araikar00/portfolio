---
import { education } from '../data/education';
---

<section class="section education" id="education" aria-labelledby="education-title">
  <div class="wrap">
    <div class="reveal">
      <p class="section-label">Education</p>
      <h2 class="section-title" id="education-title">Education</h2>
    </div>

    <div class="edu-list">
      {
        education.map((item, index) => (
          <article class="edu-item glass reveal" style={`--i: ${index}`}>
            <h3>{item.degree}</h3>
            <p class="edu-school">
              {item.school}
              {item.location ? ` · ${item.location}` : ''}
            </p>
            <p class="edu-dates">
              {item.start} — {item.end}
            </p>
            {item.details && (
              <ul class="edu-details">
                {item.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .edu-list {
    display: grid;
    gap: 1rem;
  }

  .edu-item {
    padding: clamp(1.35rem, 2.5vw, 1.75rem);
    transition-delay: calc(var(--i, 0) * 60ms);
  }

  .edu-item h3 {
    font-size: 1.25rem;
    margin-bottom: 0.3rem;
  }

  .edu-school {
    color: var(--text-secondary);
    margin-bottom: 0.2rem;
  }

  .edu-dates {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    margin-bottom: 1rem;
  }

  .edu-details {
    display: grid;
    gap: 0.45rem;
    max-width: 40rem;
  }

  .edu-details li {
    color: var(--text-secondary);
    font-size: 0.975rem;
    line-height: 1.5;
  }
</style>
