---
import { education } from '../data/education';
---

<section class="section education" id="education" aria-labelledby="education-title">
  <div class="wrap">
    <div class="reveal">
      <p class="section-label">Education</p>
      <h2 class="section-title" id="education-title">Education</h2>
      <p class="section-lead">Degree and coursework behind the work.</p>
    </div>

    <div class="edu-list">
      {
        education.map((item, index) => (
          <article class="edu-item reveal" style={`--i: ${index}`}>
            <div class="glass-dock">
              <div class="liquid-gl liquid-gl--card" aria-hidden="true"></div>
              <div class="glass-dock__content edu-inner">
                <h3>{item.degree}</h3>
                <p class="edu-school">
                  {item.school}
                  {item.location ? ` · ${item.location}` : ''}
                </p>
                <p class="edu-dates">
                  {item.start} — {item.end}
                </p>
                {item.details && (
                  <ul class="edu-details">
                    {item.details.map((detail) => (
                      <li>{detail}</li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .edu-list {
    display: grid;
    gap: 1rem;
  }

  .edu-item {
    transition-delay: calc(var(--i, 0) * 60ms);
  }

  .edu-inner {
    padding: clamp(1.35rem, 2.5vw, 1.75rem);
  }

  .edu-inner h3 {
    font-size: 1.25rem;
    margin-bottom: 0.3rem;
  }

  .edu-school {
    color: var(--text-secondary);
    font-weight: 400;
    margin-bottom: 0.2rem;
  }

  .edu-dates {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--text-tertiary);
    margin-bottom: 1rem;
  }

  .edu-details {
    display: grid;
    gap: 0.45rem;
  }

  .edu-details li {
    color: var(--text-secondary);
    font-size: 0.975rem;
    font-weight: 400;
    line-height: 1.5;
  }
</style>
