---
import { education } from '../data/education';
---

<section class="section education" id="education" aria-labelledby="education-title">
  <div class="wrap">
    <div class="reveal">
      <p class="section-label">Education</p>
      <h2 class="section-title" id="education-title">Academic foundation</h2>
      <p class="section-lead">Degree, coursework, and the fundamentals behind the work.</p>
    </div>

    <div class="edu-list">
      {
        education.map((item, index) => (
          <article class="edu-item reveal" style={`--i: ${index}`}>
            <h3>{item.degree}</h3>
            <p class="edu-school">
              {item.school}
              {item.location ? ` · ${item.location}` : ''}
            </p>
            <p class="edu-dates">
              {item.start} — {item.end}
            </p>
            {item.details && (
              <ul class="edu-details">
                {item.details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .edu-list {
    display: grid;
    gap: 1.75rem;
  }

  .edu-item {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    transition-delay: calc(var(--i, 0) * 70ms);
  }

  .edu-item h3 {
    font-size: 1.35rem;
    margin-bottom: 0.35rem;
  }

  .edu-school {
    color: var(--steel-bright);
    margin-bottom: 0.25rem;
  }

  .edu-dates {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .edu-details {
    display: grid;
    gap: 0.5rem;
    max-width: 42rem;
  }

  .edu-details li {
    color: var(--text-muted);
  }
</style>
