---
import { experience } from '../data/experience';
---

<section class="section experience" id="experience" aria-labelledby="experience-title">
  <div class="wrap">
    <div class="exp-header reveal">
      <h2 class="exp-title" id="experience-title">Experience</h2>
    </div>

    <ol class="exp-list">
      {
        experience.map((job, index) => (
          <li class="reveal" style={`--i: ${index}`}>
            <div class="glass-dock">
              <div class="liquid-gl liquid-gl--card" aria-hidden="true"></div>
              <div class="glass-dock__content exp-item">
                <div class="exp-logo" aria-hidden="true">
                  <img src={job.logo} alt="" width="96" height="96" />
                </div>

                <div class="exp-body">
                  <div class="exp-top">
                    <h3 class="exp-company">{job.company}</h3>
                    <p class="exp-dates">
                      {job.start} — {job.end}
                      {job.location ? ` · ${job.location}` : ''}
                    </p>
                  </div>
                  <p class="exp-role">{job.role}</p>

                  <p class="exp-tags" aria-label="Technologies">
                    {job.tags.join('  ')}
                  </p>

                  <ul class="exp-copy">
                    {job.description.map((paragraph) => (
                      <li>{paragraph}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .exp-header {
    margin-bottom: clamp(2rem, 4vw, 2.75rem);
  }

  .exp-title {
    font-size: clamp(1.75rem, 3.2vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .exp-list {
    display: grid;
    gap: var(--card-gap);
  }

  .exp-list > li {
    transition-delay: calc(var(--i, 0) * 70ms);
  }

  .exp-item {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
    padding: clamp(1.5rem, 3vw, 2rem);
  }

  .exp-logo {
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 1.35rem;
    overflow: hidden;
    flex-shrink: 0;
    background: #fff;
    border: 1px solid rgba(16, 16, 16, 0.06);
    box-shadow:
      0 12px 36px rgba(16, 16, 16, 0.1),
      0 4px 12px rgba(16, 16, 16, 0.05);
  }

  .exp-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .exp-body {
    min-width: 0;
    padding-top: 0.1rem;
  }

  .exp-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    margin-bottom: 0.15rem;
  }

  .exp-company {
    font-size: clamp(1.35rem, 2.6vw, 1.7rem);
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .exp-dates {
    font-size: 0.875rem;
    color: var(--text-tertiary);
  }

  .exp-role {
    font-size: 1.05rem;
    font-weight: 400;
    color: var(--text-secondary);
    margin-bottom: 0.45rem;
    letter-spacing: -0.015em;
  }

  .exp-tags {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 1.1rem;
    line-height: 1.5;
  }

  .exp-copy {
    display: grid;
    gap: 0.65rem;
  }

  .exp-copy li {
    position: relative;
    padding-left: 1rem;
    color: var(--text);
    font-size: 0.975rem;
    line-height: 1.55;
    font-weight: 400;
  }

  .exp-copy li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.7;
  }

  @media (max-width: 600px) {
    .exp-item {
      grid-template-columns: 4rem 1fr;
      gap: 1rem;
    }

    .exp-logo {
      width: 4rem;
      height: 4rem;
      border-radius: 1rem;
    }
  }
</style>
