---
import { experience } from '../data/experience';
---

<section class="section experience" id="experience" aria-labelledby="experience-title">
  <div class="wrap">
    <div class="reveal">
      <p class="section-label">Experience</p>
      <h2 class="section-title" id="experience-title">Work Experience</h2>
    </div>

    <ol class="exp-list glass reveal">
      {
        experience.map((job, index) => (
          <li class="exp-item" style={`--i: ${index}`}>
            <div class="exp-heading">
              <h3>
                {job.role}
                <span class="exp-company"> · {job.company}</span>
              </h3>
              <p class="exp-dates">
                {job.start} — {job.end}
                {job.location ? ` · ${job.location}` : ''}
              </p>
            </div>
            <ul class="exp-bullets">
              {job.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .exp-list {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: clamp(0.35rem, 1.5vw, 0.6rem);
  }

  .exp-item {
    padding: clamp(1.25rem, 2.5vw, 1.6rem) clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .exp-item + .exp-item {
    border-top: 1px solid var(--line);
  }

  .exp-heading {
    margin-bottom: 0.85rem;
  }

  .exp-heading h3 {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    margin-bottom: 0.3rem;
  }

  .exp-company {
    color: var(--text-secondary);
    font-weight: 400;
  }

  .exp-dates {
    font-size: 0.875rem;
    color: var(--text-tertiary);
  }

  .exp-bullets {
    display: grid;
    gap: 0.55rem;
    overflow-x: auto;
  }

  .exp-bullets li {
    position: relative;
    padding-left: 1rem;
    color: var(--text-secondary);
    font-size: 0.975rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  .exp-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.7;
  }
</style>
