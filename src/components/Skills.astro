---
import { skills } from '../data/skills';
---

<section class="section skills" id="skills" aria-labelledby="skills-title">
  <div class="wrap">
    <div class="reveal">
      <p class="section-label">Skills</p>
      <h2 class="section-title" id="skills-title">Tools I use to ship</h2>
      <p class="section-lead">A focused set of languages, systems, and ML-adjacent tooling.</p>
    </div>

    <div class="skill-grid">
      {
        skills.map((group, index) => (
          <div class="skill-group reveal" style={`--i: ${index}`}>
            <h3>{group.label}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skill-grid {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }

  .skill-group {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    transition-delay: calc(var(--i, 0) * 60ms);
  }

  .skill-group h3 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel);
    margin-bottom: 0.85rem;
  }

  .skill-group ul {
    display: grid;
    gap: 0.45rem;
  }

  .skill-group li {
    color: var(--text-muted);
  }
</style>
