---
import { skills } from '../data/skills';
---

<section class="section skills" id="skills" aria-labelledby="skills-title">
  <div class="wrap">
    <div class="reveal">
      <p class="section-label">Skills</p>
      <h2 class="section-title" id="skills-title">Technical Skills</h2>
      <p class="section-lead">A focused set of languages, systems, and ML-adjacent tooling.</p>
    </div>

    <div class="skill-grid">
      {
        skills.map((group, index) => (
          <div class="skill-group glass reveal" style={`--i: ${index}`}>
            <h3>{group.label}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skill-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(11.5rem, 1fr));
  }

  .skill-group {
    padding: 1.25rem 1.35rem;
    transition-delay: calc(var(--i, 0) * 50ms);
  }

  .skill-group h3 {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-tertiary);
    margin-bottom: 0.85rem;
  }

  .skill-group ul {
    display: grid;
    gap: 0.4rem;
  }

  .skill-group li {
    color: var(--text-secondary);
    font-size: 0.975rem;
  }
</style>
