---
import { projects } from '../data/projects';
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="reveal">
      <p class="section-label">Selected work</p>
      <h2 class="section-title" id="work-title">Projects</h2>
      <p class="section-lead">
        A short list of shipped or in-progress work.
      </p>
    </div>

    <div class="project-list">
      {
        projects.map((project, index) => (
          <article class="project glass reveal" style={`--i: ${index}`}>
            <div class="project-meta">
              <span class="project-index">{String(index + 1).padStart(2, '0')}</span>
              {project.href && (
                <a
                  class="project-link"
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${project.name} source on GitHub`}
                >
                  View source
                </a>
              )}
            </div>
            <h3 class="project-name">{project.name}</h3>
            <p class="project-tagline">{project.tagline}</p>
            <dl class="project-details">
              <div>
                <dt>Problem</dt>
                <dd>{project.problem}</dd>
              </div>
              <div>
                <dt>Role</dt>
                <dd>{project.role}</dd>
              </div>
              <div>
                <dt>Outcome</dt>
                <dd>{project.outcome}</dd>
              </div>
            </dl>
            <ul class="tech-list" aria-label="Technologies">
              {project.tech.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .project-list {
    display: grid;
    gap: 1.25rem;
  }

  .project {
    padding: clamp(1.5rem, 3vw, 2rem);
    transition-delay: calc(var(--i, 0) * 70ms);
  }

  .project-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .project-index {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-tertiary);
  }

  .project-link {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .project-name {
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    margin-bottom: 0.3rem;
  }

  .project-tagline {
    color: var(--text-secondary);
    margin-bottom: 1.35rem;
  }

  .project-details {
    display: grid;
    gap: 1.1rem;
    margin: 0 0 1.35rem;
  }

  .project-details dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-tertiary);
    margin-bottom: 0.3rem;
  }

  .project-details dd {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.975rem;
    line-height: 1.5;
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tech-list li {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--glass-border-soft);
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.7rem;
  }

  @media (min-width: 900px) {
    .project-details {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.35rem;
    }
  }
</style>
