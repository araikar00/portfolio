---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} — ${site.title}`, description = site.summary } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(site.ogImage, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.title,
  url: Astro.site?.href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'San Francisco',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  sameAs: [site.github, site.linkedin],
  description: site.summary,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#eaeaec" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="bg-stage" aria-hidden="true">
      <video
        autoplay
        muted
        loop
        playsinline
        poster="/media/bg-poster.webp"
        aria-label="Animated gradient background"
      >
        <source src="/media/bg.mp4" type="video/mp4" />
      </video>
      <img src="/media/bg-poster.webp" alt="" />
    </div>

    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <script>
      const revealEls = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.08, rootMargin: '0px 0px -6% 0px' },
        );
        revealEls.forEach((el) => observer.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }
    </script>

    <!-- liquidGL: classic IIFE scripts, same pattern as liquidgl.naughtyduk.com -->
    <script is:inline src="/vendor/liquidGL.js"></script>
    <script is:inline>
      (function () {
        function initLiquidGL() {
          if (typeof window.liquidGL !== 'function') {
            console.error('liquidGL failed to load');
            return;
          }

          // Match liquidgl.naughtyduk.com: crystal glass over rich video
          const video = document.querySelector('.bg-stage video');
          if (video && typeof window.liquidGL.registerDynamic === 'function') {
            window.liquidGL.registerDynamic([video]);
          }

          // Nav — same recipe as their dock lens
          if (document.querySelector('.liquid-gl--nav')) {
            window.liquidGL({
              target: '.liquid-gl--nav',
              content: '.liquid-gl--nav .liquid-gl__content',
              snapshot: 'body',
              resolution: 2,
              engine: 'auto',
              refraction: 0.02,
              aberration: 0.85,
              bevelDepth: 0.04,
              bevelWidth: 0.09,
              frost: 0,
              shadow: true,
              specular: true,
              reveal: 'fade',
              tilt: false,
              draggable: false,
              interaction: 'fluid',
              interactionStrength: 0.5,
              interactionRadius: 0.5,
              interactionViscosity: 0.35,
              magnify: 1.05,
              tint: 'rgba(234, 234, 236, 0.18)',
              helper: false,
              zIndex: 50,
            });
          }

          // Hero pane — dock pattern: empty lens + separate content overlay
          if (document.querySelector('.liquid-gl--hero')) {
            window.liquidGL({
              target: '#hero-lens',
              content: '#hero-glass-content',
              snapshot: 'body',
              resolution: 2,
              engine: 'auto',
              refraction: 0.03,
              aberration: 0.5,
              bevelDepth: 0.1,
              bevelWidth: 0.12,
              frost: 0,
              shadow: true,
              specular: true,
              reveal: 'fade',
              tilt: true,
              tiltFactor: 3,
              tiltEase: 400,
              draggable: false,
              interaction: 'fluid',
              interactionStrength: 0.4,
              interactionRadius: 0.4,
              interactionViscosity: 0.55,
              magnify: 1,
              tint: null,
              helper: false,
              zIndex: 5,
            });
          }

          window.liquidGL.syncWith();
          document.documentElement.classList.add('liquid-gl-ready');
        }

        if (document.readyState === 'complete') {
          requestAnimationFrame(initLiquidGL);
        } else {
          window.addEventListener('load', function () {
            requestAnimationFrame(initLiquidGL);
          }, { once: true });
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: var(--gutter);
    top: -3rem;
    z-index: 100;
    padding: 0.55rem 0.9rem;
    background: #101010;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-pill);
  }

  .skip-link:focus {
    top: 0.85rem;
  }

  /* Prefer video; hide poster img when video can play */
  .bg-stage img {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-stage video {
      display: none;
    }
    .bg-stage img {
      display: block;
    }
  }
</style>
