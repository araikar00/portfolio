---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} — ${site.title}`, description = site.summary } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(site.ogImage, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.title,
  url: Astro.site?.href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'San Francisco',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  sameAs: [site.github, site.linkedin],
  description: site.summary,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta
      name="keywords"
      content="Aryan Raikar, Software Engineer, Applied AI, Wells Fargo, UCSD, portfolio"
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f5f5f7" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script>
      const revealEls = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.08, rootMargin: '0px 0px -6% 0px' },
        );
        revealEls.forEach((el) => observer.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
    <!-- Official liquidGL order: library → helper → init (blocking, like demos) -->
    <script is:inline src="/vendor/liquidGL.js"></script>
    <script is:inline src="/vendor/liquidGL-helper.js"></script>
    <script is:inline>
      (function () {
        var BASE = {
          engine: 'auto',
          snapshot: 'body',
          resolution: 2.0,
          refraction: 0.01,
          aberration: 0,
          bevelDepth: 0.08,
          bevelWidth: 0.15,
          frost: 3,
          shadow: true,
          specular: true,
          reveal: 'fade',
          tilt: false,
          tiltFactor: 5,
          tiltEase: 400,
          draggable: false,
          interaction: 'none',
          magnify: 1,
          tint: null,
          helper: false,
        };

        function initLiquidGL() {
          if (typeof window.liquidGL !== 'function') {
            console.error('liquidGL failed to load from /vendor/liquidGL.js');
            return;
          }

          if (document.querySelector('.liquid-gl--nav')) {
            window.liquidGL(
              Object.assign({}, BASE, {
                target: '.liquid-gl--nav',
                frost: 4,
                refraction: 0.012,
                bevelDepth: 0.1,
                bevelWidth: 0.18,
                helper: true,
                zIndex: 50,
              }),
            );
          }

          if (document.querySelector('.liquid-gl--card')) {
            window.liquidGL(
              Object.assign({}, BASE, {
                target: '.liquid-gl--card',
                frost: 3.5,
                refraction: 0.008,
                bevelDepth: 0.07,
                bevelWidth: 0.12,
                helper: false,
              }),
            );
          }

          window.liquidGL.syncWith();
          document.documentElement.classList.add('liquid-gl-ready');
        }

        if (document.readyState === 'complete') {
          requestAnimationFrame(initLiquidGL);
        } else {
          window.addEventListener(
            'load',
            function () {
              requestAnimationFrame(initLiquidGL);
            },
            { once: true },
          );
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: var(--gutter);
    top: -3rem;
    z-index: 100;
    padding: 0.55rem 0.9rem;
    background: var(--accent);
    color: #fff;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-pill);
  }

  .skip-link:focus {
    top: 0.85rem;
  }
</style>
